# Clé API Maketou — jamais dans le frontend ni dans Git
MAKETOU_API_KEY=
# Création de panier (API officielle)
MAKETOU_API_URL=https://api.maketou.net/api/v1/stores/cart/checkout
# Vérification : GET {MAKETOU_VERIFY_URL}/api/v1/stores/cart/{cartId}
MAKETOU_VERIFY_URL=https://api.maketou.net
OROLADO_ORIGIN=https://orolado.com

# Supabase (projet tubyuyxuswwzebicrhkg)
SUPABASE_URL=https://tubyuyxuswwzebicrhkg.supabase.co
# Clé anon / publishable (eyJ… ou sb_publishable_…) — pas l’URL
SUPABASE_ANON_KEY=
# Service role : serveur uniquement, jamais dans le frontend ni Git.
# Nécessaire pour créditer vaults.real depuis le webhook si l’utilisateur ne revient pas tout de suite.
SUPABASE_SERVICE_ROLE_KEY=

# Lecture du journal Maketou : https://orolado.com/debug-maketou.php?key=<cette valeur>
DEBUG_LOG_KEY=
# Toujours 0 : on ne crédite JAMAIS sans confirmation Maketou (status completed)
MAKETOU_TRUST_RETURN=0
MAKETOU_DIRECT_RETURN=0

# OxaPay — clé marchand (serveur uniquement, jamais dans le frontend)
OXAPAY_MERCHANT_KEY=

# Flutterwave LIVE — serveur uniquement, jamais dans le frontend
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=

# Meta Ads — Pixel (frontend) + Conversions API (serveur, jamais dans le JS)
META_PIXEL_ID=935068479097391
META_ACCESS_TOKEN=

# Compte admin — serveur uniquement, jamais dans le JavaScript
ADMIN_EMAIL=admin@orolado.com
ADMIN_PASSWORD=

# Brevo — e-mails transactionnels (serveur uniquement, jamais dans le frontend)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@mail.orolado.com
BREVO_SENDER_NAME=Orolado

# Devise plateforme = USD (soldes). Recharge Maketou = FCFA (customerPrice XOF).
# 3 000 FCFA → crédit vault via taux interne
USD_FCFA_RATE=600
