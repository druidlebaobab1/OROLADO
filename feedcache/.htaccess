# Prix en direct. live.js est demandé avec une adresse différente toutes les 250 ms
# (?t=…, calée sur l'heure du serveur) : Cloudflare peut donc en garder une copie et la
# servir à tous les joueurs de ce quart de seconde, sans jamais servir un vieux prix.
<IfModule mod_headers.c>
  <Files "live.js">
    Header set Cache-Control "public, max-age=30"
    Header unset Expires
  </Files>
</IfModule>
<IfModule mod_mime.c>
  AddType application/javascript .js
</IfModule>
