DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^admin/?$ /index.html [L]
  RewriteRule ^api/maketou-webhook/?$ api/maketou-webhook.php [L,QSA]
  RewriteRule ^api/deposit/initiate/?$ api/deposit-initiate.php [L,QSA]
  RewriteRule ^api/deposit/confirm/?$ api/deposit-confirm.php [L,QSA]
  RewriteRule ^api/deposit/webhook/?$ api/deposit-webhook.php [L,QSA]
  RewriteRule ^api/deposit/verify-crypto/?$ api/deposit-verify-crypto.php [L,QSA]
  RewriteRule ^api/oxapay/invoice/?$ api/oxapay-invoice.php [L,QSA]
  RewriteRule ^api/oxapay/status/?$ api/oxapay-status.php [L,QSA]
  RewriteRule ^api/oxapay/webhook/?$ api/oxapay-webhook.php [L,QSA]
  RewriteRule ^api/flutterwave/checkout/?$ api/flutterwave-checkout.php [L,QSA]
  RewriteRule ^api/flutterwave/charge/?$ api/flutterwave-charge.php [L,QSA]
  RewriteRule ^api/flutterwave/webhook/?$ api/flutterwave-webhook.php [L,QSA]
  RewriteRule ^api/flutterwave/callback/?$ api/flutterwave-callback.php [L,QSA]
  RewriteRule ^api/flutterwave/status/?$ api/flutterwave-status.php [L,QSA]
  RewriteRule ^api/flutterwave/verify/?$ api/flutterwave-verify.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest .json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

<Files ".env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest .json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
